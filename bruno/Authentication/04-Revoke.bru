meta {
  name: Revoke refresh family
  type: http
  seq: 4
  tags: [
    auth-flow
  ]
}

post {
  url: {{base_url}}/api/method/api.auth.revoke
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"refresh_token":"{{refresh_token}}"}
}

script:pre-request {
  if (!bru.getVar("refresh_token")) {
    throw new Error("Run Issue/Refresh first or provide a refresh_token privately");
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("revoked_refresh_token", bru.getVar("refresh_token"));
    bru.setVar("refresh_token", "");
    bru.setVar("access_token", "");
  }
}

tests {
  test("Logout is idempotent and returns no-store", function () {
    expect(res.status).to.equal(200);
    expect(res.body.message.revoked).to.equal(true);
    expect(res.headers["cache-control"]).to.include("no-store");
  });
}

docs {
  # Revoke — endpoint baru JWT P1

  Source: api/api/auth.py:revoke dan api/services/auth/refresh_tokens.py:revoke.
  POST tanpa Authorization. refresh_token wajib string nonempty maksimum 512 karakter.
  Idempotent: unknown/expired/already-revoked well-shaped tokens tetap 200.
  Jika ditemukan, seluruh family direvoke. Rate limit 30/IP/menit.
  Access JWT yang sudah terbit tetap valid sampai exp; client membuang keduanya
  setelah logout. Script membersihkan pair runtime dan menyimpan revoked_refresh_token
  sementara untuk request verifikasi 05. Ini bukan penghapusan record audit.
}

example {
  name: Family revoked (illustrative)
  request: {
    url: {{base_url}}/api/method/api.auth.revoke
    method: post
    mode: json
    body:json: {
      {"refresh_token":"<opaque-token>"}
    }
  }
  response: {
    status: {
      code: 200
    }
    body: {
      type: json
      content: '''
        {"message":{"revoked":true}}
      '''
    }
  }
}
